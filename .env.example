# ─────────────────────────────────────────────────────────
#  .env.example – Copy to .env and fill in real values
# ─────────────────────────────────────────────────────────

DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require

DB_HOST=<host>
DB_PORT=5432
DB_NAME=<database>
DB_USER=<user>
DB_PASSWORD=<password>
DB_SSL_MODE=require
